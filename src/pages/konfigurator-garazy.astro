---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/ui/Nav.astro';
import Footer from '@/components/sections/Footer.astro';
import FloatingCTA from '@/components/ui/FloatingCTA.astro';
import { site } from '@/config/site';
import '@/styles/landing-page.css';

const pricingPlans = [
  {
    name: 'Start',
    badge: null,
    icon: '🚀',
    monthlyPrice: 499,
    description: 'Idealny na początek. Wszystko czego potrzebujesz do zbierania zapytań ofertowych online.',
    features: [
      { text: 'Konfigurator 3D w przeglądarce (PC, tablet, telefon)', included: true },
      { text: 'Personalizacja: logo, kolory, stopka', included: true },
      { text: '6 typów dachów, blachodachówka i trapez, konfigurowalny zakres wymiarów', included: true },
      { text: 'Kolory ścian, dachu, tłoczenia i obróbki blacharskie', included: true },
      { text: 'Bramy uchylne i dwuskrzydłowe, drzwi serwisowe, okna', included: true },
      { text: 'Wiaty ażurowe, napęd elektryczny, filc, kotwienie', included: true },
      { text: 'Formularz kontaktowy ze zrzutami 3D', included: true },
      { text: 'Hosting, SSL, aktualizacje i podstawowy system kolizji', included: true },
    ],
    cta: 'Wybierz Start',
    demoUrl: 'https://konfigli.pl/konfigurator-garazy-start/',
  },
  {
    name: 'Pro',
    badge: 'Popularny',
    icon: '⚡',
    monthlyPrice: 799,
    description: 'Pełna jakość 3D i zaawansowane funkcje dla wymagających producentów.',
    features: [
      { text: 'Wszystko z pakietu Start', included: true, bold: true },
      { text: 'Pełna jakość wizualizacji 3D', included: true, isExtra: true },
      { text: 'Zaawansowany system kolizji', included: true, isExtra: true },
      { text: 'Konfiguracja dostępnych opcji i zakresów', included: true, isExtra: true },
      { text: 'Rynny, bramy segmentowe, zabudowa wiat blachą', included: true, isExtra: true },
    ],
    cta: 'Wybierz Pro',
    demoUrl: 'https://konfigli.pl/konfigurator-garazy-pro/',
  },
  {
    name: 'Premium',
    badge: 'Najlepszy',
    icon: '👑',
    monthlyPrice: 1199,
    description: 'Kompletne narzędzie sprzedażowe z rysunkami technicznymi i wszystkimi opcjami.',
    features: [
      { text: 'Wszystko z pakietu Pro', included: true, bold: true },
      { text: 'Menu kontekstowe: edycja, przesuwanie i kolorowanie obiektów', included: true, isExtra: true },
      { text: 'Kolor obróbek blacharskich ścian i dachu', included: true, isExtra: true },
      { text: 'Wnęki narożne (4 pozycje) i bramy na tylnej ścianie', included: true, isExtra: true },
      { text: 'Geometria dachu: centrowanie kalenicy, wydłużanie z każdej strony', included: true, isExtra: true },
      { text: 'Widok 2D, niestandardowe wymiary i wymiarowanie na modelu', included: true, isExtra: true },
      { text: 'Rysunki techniczne: elewacje, rzut i wymiarowanie', included: true, isExtra: true },
      { text: 'Priorytetowe wsparcie techniczne', included: true, isExtra: true },
    ],
    cta: 'Wybierz Premium',
    demoUrl: 'https://konfigli.pl/konfigurator-garazy-premium/',
  },
];

const faqItems = [
  { question: 'Ile kosztuje konfigurator garaży blaszanych?', answer: 'Od 499 PLN/msc (Start) do 1 199 PLN/msc (Premium). Bez opłaty wdrożeniowej.' },
  { question: 'Czy mogę przetestować konfigurator przed zakupem?', answer: 'Tak, umów się na konsultację, pokażę demo z Twoim logo. Możesz też wypróbować demo na tej stronie.' },
  { question: 'Jak długo trwa wdrożenie konfiguratora?', answer: '1–5 dni roboczych, zależnie od pakietu.' },
  { question: 'Czy mogę zmienić pakiet w trakcie trwania abonamentu?', answer: 'Tak, przechodzisz na wyższy pakiet w dowolnym momencie. Zmiana od następnego okresu rozliczeniowego.' },
  { question: 'Czy konfigurator działa na telefonach i tabletach?', answer: 'Tak, w przeglądarce, bez instalacji. Działa płynnie nawet na starszych smartfonach.' },
  { question: 'Czy mogę osadzić konfigurator na istniejącej stronie?', answer: 'Tak, osadzam na dowolnej stronie: WordPress, własny CMS, landing page.' },
  { question: 'Czy konfigurator może automatycznie wyceniać garaże?', answer: 'Tak, mogę wbudować logikę cenową, która liczy wycenę na podstawie wymiarów i wariantów w czasie rzeczywistym.' },
  { question: 'Jakie typy dachów obsługuje konfigurator garaży blaszanych?', answer: '6 typów: dwuspadowy symetryczny i asymetryczny, jednospadowy (4 kierunki spadku). Pokrycie: trapez lub blachodachówka.' },
  { question: 'Czym się różni konfigurator 3D od zwykłego kalkulatora garaży?', answer: 'Kalkulator to formularz z ceną. Konfigurator 3D to wizualizacja, w której klient widzi garaż z każdej strony, w wybranych kolorach i wymiarach.' },
  { question: 'Czy konfigurator generuje rysunki techniczne garażu?', answer: 'Tak, w pakiecie Premium: elewacje, rzut z góry, wymiarowanie i specyfikacja techniczna. Eksport do PDF.' },
  { question: 'Co się stanie jeśli zrezygnuję z abonamentu?', answer: 'Konfigurator zostaje wyłączony z końcem opłaconego okresu. Dane przechowuję 90 dni. Jeśli wrócisz, uruchamiam go bez ponownego wdrożenia.' },
  { question: 'Czy konfigurator obsługuje kolory drewnopodobne?', answer: 'Tak, konfiguruję dowolne kolory RAL i drewnopodobne pod asortyment producenta.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://konfigli.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Konfigurator garaży blaszanych 3D' },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Konfigurator garaży blaszanych 3D',
  description: 'Interaktywny konfigurator 3D garaży blaszanych. Wybierz wymiary, kolor, typ dachu i bramy — zobacz efekt na modelu 3D w czasie rzeczywistym i wyślij gotowe zapytanie.',
  url: 'https://konfigli.pl/konfigurator-garazy/',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript and WebGL 2.0',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'PLN',
    lowPrice: '499',
    highPrice: '1199',
    offerCount: 3,
  },
  featureList: [
    'Wizualizacja 3D w czasie rzeczywistym',
    '6 typów dachu do wyboru',
    'Konfigurowalny zakres wymiarów',
    'Rysunki techniczne',
    'Formularz z gotową specyfikacją',
  ],
  screenshot: 'https://konfigli.pl/images/portfolio/kaem-stal.png',
  creator: {
    '@type': 'ProfessionalService',
    name: 'Konfigli',
    url: 'https://konfigli.pl',
  },
  inLanguage: 'pl-PL',
};
---

<BaseLayout
  title="Konfigurator garaży blaszanych 3D online — cennik od 499 PLN/msc"
  description="Konfigurator garaży blaszanych 3D — klient sam projektuje garaż w 3D i wysyła gotowe zapytanie. Ty dostajesz lead ze specyfikacją. Abonament od 499 PLN/msc."
  showHomeSchemas={false}
  keywords={[
    'konfigurator garaży blaszanych',
    'konfigurator garaży blaszanych 3D',
    'konfigurator garaży blaszanych online',
    'konfigurator garaży blaszanych z ceną',
    'konfigurator garaży 3D',
    'konfigurator garaży online',
    'wizualizacja 3D garażu blaszanego',
    'kalkulator garaży blaszanych',
    'konfigurator 3D garaży',
    'rysunki techniczne garażu blaszanego',
    'skonfiguruj garaż blaszany',
    'garaż blaszany konfigurator',
    'cennik garaży blaszanych',
    'konfigurator garaży drewnopodobnych',
    'konfigurator garaży abonament',
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  </Fragment>
  <Nav />
  <main>
    <!-- Hero -->
    <section class="lp-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="lp-breadcrumb">
          <ol>
            <li><a href="/">Konfigli</a></li>
            <li aria-current="page">Konfigurator garaży blaszanych</li>
          </ol>
        </nav>
        <span class="lp-badge">Konfigurator 3D w abonamencie</span>
        <h1 class="lp-hero__title">
          Konfigurator garaży blaszanych 3D<br />
          <span class="gradient-text">na Twojej stronie od 499 PLN/msc</span>
        </h1>
        <p class="lp-hero__subtitle">
          Klient sam projektuje garaż w 3D na Twojej stronie i wysyła gotowe zapytanie. Bez telefonów, bez cenników PDF. Od 499 PLN/msc.
        </p>
        <div class="lp-hero__actions">
          <a href="#cennik" class="lp-btn lp-btn--primary">Zobacz cennik</a>
          <a href="#kontakt" class="lp-btn lp-btn--secondary">Umów konsultację</a>
        </div>
      </div>
    </section>

    <!-- Problems -->
    <section class="lp-section lp-section--alt" id="problemy">
      <div class="container">
        <h2 class="lp-section__title">Znasz to z codziennej pracy?</h2>
        <div class="lp-problems">
          <div class="lp-problem">
            <div class="lp-problem__icon">📞</div>
            <h3>Telefon za telefonem</h3>
            <p>Klient dzwoni: «chcę garaż 6 na 5 z takim dachem...». Ty próbujesz to zrozumieć i wycenić. Pół godziny na jedno zapytanie.</p>
          </div>
          <div class="lp-problem">
            <div class="lp-problem__icon">📄</div>
            <h3>Cennik PDF, którego nikt nie czyta</h3>
            <p>12 stron tabelek. Klient się gubi i idzie do konkurencji, która ma konfigurator na stronie.</p>
          </div>
          <div class="lp-problem">
            <div class="lp-problem__icon">🌙</div>
            <h3>Zapytania tylko w godzinach pracy</h3>
            <p>Klient szuka wieczorem. Twoja strona ma tylko numer telefonu, więc zapytanie trafia do konkurencji.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Solution / Features -->
    <section class="lp-section" id="funkcje">
      <div class="container">
        <h2 class="lp-section__title">Co może Twój klient w konfiguratorze?</h2>
        <p class="lp-section__desc">Nie formularz z listą opcji. Prawdziwy kreator 3D, który prowadzi klienta od wymiarów do gotowej oferty.</p>
        <div class="lp-features">
          <div class="lp-feature">
            <div class="lp-feature__icon">🧭</div>
            <h3>Kreator krok po kroku</h3>
            <p>Panel prowadzi przez każdy etap: wymiary, dach, bramy, akcesoria. Klient nie zgaduje, co dalej.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">🖱️</div>
            <h3>Menu kontekstowe na obiektach</h3>
            <p>Kliknięcie elementu otwiera opcje: zmień kolor ażura, usuń wybrany panel, dodaj bramę z przodu lub z tyłu.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">📐</div>
            <h3>Rozbudowa na każdą stronę</h3>
            <p>Wydłuż dach z dowolnej strony, dodaj wiatę z 1, 2 lub 3 stron, zabuduj ażurem lub blachą.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">📏</div>
            <h3>Wymiary i geometria</h3>
            <p>Niestandardowe wymiary suwakami, zmiana wysrodkowania kalenicy, wnęki narożne z drzwiami i oknami.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">🛡️</div>
            <h3>System kolizji</h3>
            <p>Obiekty nie mogą na siebie najeżdżać. Konfigurator sam pilnuje, żeby konfiguracja była możliwa do wykonania.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">🎨</div>
            <h3>Realistyczne wykończenia</h3>
            <p>Kolory RAL, drewnopodobne w pełnej jakości 3D, wizualizacja rynien i obróbek blacharskich.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- Pricing -->
    <section class="lp-section" id="cennik">
      <div class="container">
        <h2 class="lp-section__title">Cennik konfiguratora garaży blaszanych w abonamencie</h2>
        <p class="lp-section__desc">Abonament miesięczny, bez opłaty wdrożeniowej. Hosting, SSL i aktualizacje w cenie.</p>

        <div class="lp-pricing">
          {pricingPlans.map((plan) => (
            <div class={`lp-pricing__card ${plan.badge === 'Popularny' ? 'lp-pricing__card--featured' : ''}`}>
              {plan.badge && <span class="lp-pricing__badge">{plan.badge}</span>}
              <div class="lp-pricing__header">
                <div class="lp-pricing__icon">{plan.icon}</div>
                <h3 class="lp-pricing__name">{plan.name}</h3>
                <p class="lp-pricing__desc">{plan.description}</p>
                <div class="lp-pricing__price">
                  <span class="lp-pricing__amount">{plan.monthlyPrice}</span>
                  <span class="lp-pricing__period">PLN / msc</span>
                </div>
              </div>
              <ul class="lp-pricing__features">
                {plan.features.map((f) => (
                  <li class={`${!f.included ? 'lp-pricing__feature--disabled' : ''} ${f.isExtra ? 'lp-pricing__feature--extra' : ''} ${f.bold ? 'lp-pricing__feature--bold' : ''}`}>
                    <span class="lp-pricing__feature-icon">{f.isExtra ? '+' : f.included ? '✓' : '—'}</span>
                    {f.text}
                  </li>
                ))}
              </ul>
              <div class="lp-pricing__footer">
                <a href="#kontakt" class={`lp-btn ${plan.name === 'Premium' ? 'lp-btn--primary' : 'lp-btn--secondary'}`}>{plan.cta}</a>
                <a href={plan.demoUrl} target="_blank" rel="noopener" class="lp-pricing__demo-link">Zobacz demo →</a>
              </div>
            </div>
          ))}
        </div>

        <p class="lp-pricing__note">Potrzebujesz indywidualnych funkcji? <a href="#kontakt">Napisz, wycenię w 24h</a>.</p>
      </div>
    </section>

    <!-- How it works -->
    <section class="lp-section lp-section--alt" id="wdrozenie">
      <div class="container">
        <h2 class="lp-section__title">Jak wygląda wdrożenie?</h2>
        <p class="lp-section__desc">Od pierwszego kontaktu do konfiguratora na Twojej stronie w 5 prostych krokach.</p>
        <div class="lp-steps">
          <div class="lp-step">
            <span class="lp-step__number">1</span>
            <h3>Konsultacja</h3>
            <p>Ustalamy Twój asortyment, kolory i zakresy wymiarów.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">2</span>
            <h3>Personalizacja</h3>
            <p>Konfiguruję logo, kolory i formularz pod Twoją firmę.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">3</span>
            <h3>Testowanie</h3>
            <p>Dostajesz link do testowej wersji, sprawdzasz i zgłaszasz uwagi.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">4</span>
            <h3>Wdrożenie</h3>
            <p>Osadzam konfigurator na Twojej stronie.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">5</span>
            <h3>Wsparcie i rozwój</h3>
            <p>Aktualizacje i pomoc techniczna przez cały czas abonamentu.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section class="lp-section">
      <div class="container">
        <h2 class="lp-section__title">Konfigurator i kalkulator garaży blaszanych. Czym się różnią?</h2>
        <div class="lp-prose">
          <p>
            <strong>Kalkulator garaży blaszanych</strong> to formularz z listą opcji i ceną. <strong>Konfigurator garaży 3D</strong> idzie dalej: klient widzi garaż z każdej strony, obraca go, zmienia kolory i wymiary w czasie rzeczywistym. To jak zaprojektować garaż online, zanim wyśle się zapytanie.
          </p>
          <p>
            Dla producenta różnica jest prosta: kalkulator generuje cenę, konfigurator generuje sprzedaż. Klient, który widzi swój garaż w 3D, w wybranych kolorach RAL, z dachem dwuspadowym i bramą segmentową, jest bliżej zakupu niż ten, który scrolluje PDF z cennikiem.
          </p>
          <p>
            Każdy konfigurator buduję pod producenta, z jego kolorami, wymiarami i typami bram. Obsługuję też <strong>kolory drewnopodobne</strong>, które coraz więcej klientów wybiera. Konfigurator działa na każdym urządzeniu, w przeglądarce, bez instalacji.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="lp-section" id="faq">
      <div class="container">
        <h2 class="lp-section__title">Najczęstsze pytania o konfigurator garaży</h2>
        <div class="lp-faq">
          {faqItems.map((item) => (
            <details class="lp-faq__item">
              <summary class="lp-faq__question">{item.question}</summary>
              <p class="lp-faq__answer">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Cross-linking -->
    <section class="lp-section">
      <div class="container" style="text-align: center;">
        <p class="lp-section__desc">Szukasz konfiguratora innego produktu?</p>
        <div class="lp-cta__buttons">
          <a href="/konfigurator-wiat-smietnikowych/" class="lp-btn lp-btn--secondary">Konfigurator wiat śmietnikowych 3D</a>
          <a href="/#uslugi" class="lp-btn lp-btn--secondary">Konfigurator 3D na zamówienie</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="lp-section lp-cta" id="kontakt">
      <div class="container">
        <h2 class="lp-section__title">Chcesz konfigurator garaży na swojej stronie?</h2>
        <p class="lp-section__desc">
          Napisz lub zadzwoń. Pokażę demo i dobierzemy pakiet.
        </p>
        <div class="lp-cta__buttons">
          <a href={`mailto:${site.contact.email}`} class="lp-btn lp-btn--primary">
            {site.contact.email}
          </a>
          <a href={`tel:${site.contact.phone}`} class="lp-btn lp-btn--secondary">
            {site.contact.phone}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingCTA />
</BaseLayout>

<script>
  import '@/scripts/theme';
  import '@/scripts/smooth-scroll';
  import '@/scripts/scroll-animations';
  import '@/scripts/nav';
  import '@/scripts/particles';
</script>
