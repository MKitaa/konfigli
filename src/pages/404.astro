---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/ui/Nav.astro';
import Footer from '@/components/sections/Footer.astro';
---

<BaseLayout
  title="Strona nie znaleziona"
  description="Strona, której szukasz, nie istnieje. Wróć na stronę główną Konfigli."
  robots="noindex, nofollow"
  showHomeSchemas={false}
>
  <Nav />
  <main>
    <section class="not-found">
      <div class="container not-found__container">
        <p class="not-found__code">404</p>
        <h1 class="not-found__title">Strona nie znaleziona</h1>
        <p class="not-found__desc">
          Ta strona nie istnieje lub została przeniesiona.<br />
          Wróć na stronę główną lub skontaktuj się z nami.
        </p>
        <div class="not-found__actions">
          <a href="/" class="not-found__btn not-found__btn--primary">Wróć na stronę główną</a>
          <a href="/#kontakt" class="not-found__btn not-found__btn--secondary">Skontaktuj się</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found {
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    padding-block: var(--space-section);
  }

  .not-found__container {
    text-align: center;
  }

  .not-found__code {
    font-family: var(--font-heading);
    font-size: clamp(6rem, 3rem + 10vw, 12rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-border);
    margin-bottom: var(--space-lg);
    letter-spacing: -0.04em;
  }

  .not-found__title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-lg);
  }

  .not-found__desc {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    justify-content: center;
  }

  .not-found__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.75rem 1.75rem;
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .not-found__btn--primary {
    background: var(--gradient-accent);
    color: white;
    box-shadow: var(--shadow-accent);
  }

  .not-found__btn--primary:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 30px rgba(249, 115, 22, 0.35);
  }

  .not-found__btn--secondary {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .not-found__btn--secondary:hover {
    border-color: var(--color-border-hover);
    background: var(--color-accent-light);
  }
</style>

<script>
  import '@/scripts/theme';
</script>
