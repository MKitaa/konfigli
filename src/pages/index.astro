---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/ui/Nav.astro';
import Hero from '@/components/sections/Hero.astro';
import SocialProof from '@/components/sections/SocialProof.astro';
import PainPoints from '@/components/sections/PainPoints.astro';
import Configurator from '@/components/sections/Configurator.astro';
import Services from '@/components/sections/Services.astro';
import CaseStudies from '@/components/sections/CaseStudies.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Process from '@/components/sections/Process.astro';
import WhyMe from '@/components/sections/WhyMe.astro';
import FAQ from '@/components/sections/FAQ.astro';
import Contact from '@/components/sections/Contact.astro';
import Footer from '@/components/sections/Footer.astro';
import FloatingCTA from '@/components/ui/FloatingCTA.astro';
import InlineCTA from '@/components/ui/InlineCTA.astro';
---

<BaseLayout>
  <Nav />
  <main>
    <Hero />
    <SocialProof />
    <hr class="section-divider" />
    <PainPoints />
    <hr class="section-divider" />
    <Configurator />
    <InlineCTA text="Chcesz taki konfigurator?" linkText="Bezpłatna wycena w 24h →" />
    <hr class="section-divider" />
    <Services />
    <hr class="section-divider" />
    <CaseStudies />
    <InlineCTA text="Chcesz takie rozwiązanie dla swojego produktu?" linkText="Porozmawiajmy →" />
    <hr class="section-divider" />
    <Testimonials />
    <hr class="section-divider" />
    <WhyMe />
    <hr class="section-divider" />
    <Process />
    <hr class="section-divider" />
    <FAQ />
    <hr class="section-divider" />
    <Contact />
  </main>
  <Footer />
  <FloatingCTA />
</BaseLayout>

<script>
  import '@/scripts/theme';
  import '@/scripts/smooth-scroll';
  import '@/scripts/scroll-animations';
  import '@/scripts/nav';
  import '@/scripts/particles';
</script>
