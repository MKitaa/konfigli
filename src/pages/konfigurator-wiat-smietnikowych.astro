---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/ui/Nav.astro';
import Footer from '@/components/sections/Footer.astro';
import FloatingCTA from '@/components/ui/FloatingCTA.astro';
import { site } from '@/config/site';
import '@/styles/landing-page.css';

const pricingPlan = {
  name: 'Konfigurator wiat śmietnikowych',
  monthlyPrice: 399,
  description: 'Jeden pakiet, wszystko w cenie. Bez ukrytych kosztów.',
  features: [
    'Konfigurator 3D w przeglądarce (PC, tablet, telefon)',
    'Personalizacja: logo, kolory, stopka producenta',
    'Wymiary wiaty, ścianka działowa, drzwi pojedyncze i dwuskrzydłowe',
    'Kolory RAL, wypełnienie: panel, drewno lub blacha',
    'Kolor obróbek blacharskich, typ dachu i pokrycia',
    'Formularz kontaktowy ze zrzutami 3D i specyfikacją',
    'Hosting, SSL, aktualizacje i wsparcie techniczne',
  ],
  demoUrl: 'https://konfigli.pl/wiaty-smietnikowe/',
};

const faqItems = [
  { question: 'Ile kosztuje konfigurator wiat śmietnikowych?', answer: '399 PLN/msc. Hosting, SSL i wsparcie w cenie, bez opłaty wdrożeniowej.' },
  { question: 'Czy mogę przetestować konfigurator przed zakupem?', answer: 'Tak, umów się na konsultację lub wypróbuj publiczne demo na tej stronie.' },
  { question: 'Jak długo trwa wdrożenie?', answer: '1–3 dni robocze.' },
  { question: 'Czy konfigurator działa na telefonach?', answer: 'Tak, w przeglądarce. Bez instalacji.' },
  { question: 'Czy mogę osadzić konfigurator na istniejącej stronie?', answer: 'Tak, osadzam na dowolnej stronie: WordPress, własny CMS, landing page.' },
  { question: 'Czy wspólnoty mieszkaniowe korzystają z konfiguratorów?', answer: 'Tak, zarządca konfiguruje wiatę, generuje wizualizację 3D i pokazuje ją na zebraniu.' },
  { question: 'Czy konfigurator może automatycznie wyceniać wiaty?', answer: 'Tak, mogę wbudować logikę cenową. Klient widzi szacunkową cenę w zależności od konfiguracji.' },
  { question: 'Ile boksów można skonfigurować?', answer: 'Od 1 do 8 lub więcej, konfigurowane pod asortyment producenta.' },
  { question: 'Jakie kolory RAL są dostępne?', answer: 'Dowolne kolory z palety RAL, ustawione pod Twój asortyment. Klient widzi wybrany kolor na modelu 3D.' },
  { question: 'Co się stanie jeśli zrezygnuję z abonamentu?', answer: 'Konfigurator zostaje wyłączony z końcem opłaconego okresu. Dane przechowuję 90 dni. Jeśli wrócisz, uruchamiam bez ponownego wdrożenia.' },
  { question: 'Ile kosztuje wiata śmietnikowa z konfiguratora?', answer: 'Cena wiaty zależy od konfiguracji: liczby boksów, wymiarów i materiału. Konfigurator może pokazywać szacunkową cenę w czasie rzeczywistym.' },
  { question: 'Czy konfigurator pokazuje wiatę śmietnikową na wymiar?', answer: 'Tak, klient ustawia dokładne wymiary pod swoje pojemniki. Model 3D aktualizuje się na żywo.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://konfigli.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Konfigurator wiat śmietnikowych 3D' },
  ],
};

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Konfigurator wiat śmietnikowych 3D',
  description: 'Interaktywny konfigurator 3D wiat śmietnikowych. Dobierz liczbę boksów, wymiary, kolor i rodzaj wypełnienia — zobacz efekt na modelu 3D.',
  url: 'https://konfigli.pl/konfigurator-wiat-smietnikowych/',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires JavaScript and WebGL 2.0',
  offers: {
    '@type': 'Offer',
    price: '399',
    priceCurrency: 'PLN',
    description: 'Abonament miesięczny, bez opłaty wdrożeniowej',
  },
  featureList: [
    'Wizualizacja 3D w czasie rzeczywistym',
    'Wybór liczby boksów na odpady',
    'Konfiguracja wymiarów wiaty',
    'Kolory konstrukcji i wypełnienia',
    'Formularz z gotową specyfikacją',
  ],
  screenshot: 'https://konfigli.pl/images/portfolio/wiz-wiat.png',
  creator: {
    '@type': 'ProfessionalService',
    name: 'Konfigli',
    url: 'https://konfigli.pl',
  },
  inLanguage: 'pl-PL',
};
---

<BaseLayout
  title="Konfigurator wiat śmietnikowych 3D online — cennik od 399 PLN/msc"
  description="Konfigurator wiat śmietnikowych 3D — wiata śmietnikowa na wymiar z wizualizacją online. Klient dobiera boksy, kolor i wymiary, Ty dostajesz gotowe zapytanie. Abonament 399 PLN/msc."
  showHomeSchemas={false}
  keywords={[
    'konfigurator wiat śmietnikowych',
    'konfigurator wiat śmietnikowych 3D',
    'konfigurator wiat śmietnikowych online',
    'wiata śmietnikowa konfigurator',
    'wiata śmietnikowa 3D',
    'konfigurator wiat online',
    'wizualizacja 3D wiaty śmietnikowej',
    'wiata śmietnikowa dla wspólnoty mieszkaniowej',
    'konfigurator wiat z ceną',
    'wiaty śmietnikowe producent konfigurator',
    'wiata śmietnikowa na wymiar',
    'wiata śmietnikowa cena',
    'wiata śmietnikowa producent',
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
  </Fragment>
  <Nav />
  <main>
    <!-- Hero -->
    <section class="lp-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="lp-breadcrumb">
          <ol>
            <li><a href="/">Konfigli</a></li>
            <li aria-current="page">Konfigurator wiat śmietnikowych</li>
          </ol>
        </nav>
        <span class="lp-badge">Konfigurator 3D w abonamencie</span>
        <h1 class="lp-hero__title">
          Konfigurator wiat śmietnikowych 3D<br />
          <span class="gradient-text">na Twojej stronie od 399 PLN/msc</span>
        </h1>
        <p class="lp-hero__subtitle">
          Klient dobiera boksy, wymiary i kolor, a potem wysyła gotowe zapytanie z wizualizacją 3D. Od 399 PLN/msc, bez opłaty wdrożeniowej.
        </p>
        <div class="lp-hero__actions">
          <a href="#cennik" class="lp-btn lp-btn--primary">Zobacz cennik</a>
          <a href="#kontakt" class="lp-btn lp-btn--secondary">Umów konsultację</a>
        </div>
      </div>
    </section>

    <!-- Problems -->
    <section class="lp-section lp-section--alt" id="problemy">
      <div class="container">
        <h2 class="lp-section__title">Sprzedaż wiat śmietnikowych. Znasz te problemy?</h2>
        <div class="lp-problems">
          <div class="lp-problem">
            <div class="lp-problem__icon">📞</div>
            <h3>Klient nie wie czego chce</h3>
            <p>Dzwoni z pytaniem «ile kosztuje wiata na 4 pojemniki?», ale nie zna wymiarów ani koloru. Każda rozmowa to 20 minut wyciągania szczegółów.</p>
          </div>
          <div class="lp-problem">
            <div class="lp-problem__icon">🏘️</div>
            <h3>Wspólnoty decydują miesiącami</h3>
            <p>Zarządca musi przedstawić ofertę na zebraniu. Bez wizualizacji dyskusja ciągnie się tygodniami.</p>
          </div>
          <div class="lp-problem">
            <div class="lp-problem__icon">📄</div>
            <h3>Oferty robione ręcznie</h3>
            <p>Każde zapytanie to ręczna wycena, zrzuty z katalogu i opis. Konfigurator robi to za Ciebie.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section class="lp-section" id="funkcje">
      <div class="container">
        <h2 class="lp-section__title">Co może Twój klient w konfiguratorze?</h2>
        <p class="lp-section__desc">Nie formularz z listą opcji. Prawdziwy kreator 3D, który prowadzi klienta od wymiarów do gotowej oferty.</p>
        <div class="lp-features">
          <div class="lp-feature">
            <div class="lp-feature__icon">🧱</div>
            <h3>Ścianka działowa</h3>
            <p>Opcjonalna ścianka między boksami, widoczna na modelu 3D.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">🚪</div>
            <h3>Drzwi pojedyncze i dwuskrzydłowe</h3>
            <p>Dwa typy drzwi do wyboru, dopasowane do szerokości boksu i sposobu użytkowania.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">📏</div>
            <h3>Wymiary na wymiar</h3>
            <p>Szerokość, głębokość i wysokość ustawiane suwakami pod konkretne pojemniki.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">🎨</div>
            <h3>Kolory, materiały i obróbki</h3>
            <p>Paleta RAL, wypełnienie: panel, drewno lub blacha. Kolor obróbek blacharskich do wyboru.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">🏠</div>
            <h3>Typ dachu</h3>
            <p>Wybór pokrycia dachowego, kąt nachylenia obliczany automatycznie.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">📋</div>
            <h3>Automatyczna oferta</h3>
            <p>Zrzuty 3D, pełna specyfikacja i formularz kontaktowy jednym kliknięciem.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- Pricing (single plan) -->
    <section class="lp-section lp-section--alt" id="cennik">
      <div class="container">
        <h2 class="lp-section__title">Cennik konfiguratora wiat śmietnikowych w abonamencie</h2>
        <p class="lp-section__desc">Jeden pakiet, wszystko w cenie. Bez ukrytych kosztów.</p>

        <div class="lp-pricing lp-pricing--single">
          <div class="lp-pricing__card lp-pricing__card--featured">
            <span class="lp-pricing__badge">Kompletny pakiet</span>
            <div class="lp-pricing__header">
              <h3 class="lp-pricing__name">{pricingPlan.name}</h3>
              <p class="lp-pricing__desc">{pricingPlan.description}</p>
              <div class="lp-pricing__price">
                <span class="lp-pricing__amount">{pricingPlan.monthlyPrice}</span>
                <span class="lp-pricing__period">PLN / msc</span>
              </div>
            </div>
            <ul class="lp-pricing__features">
              {pricingPlan.features.map((f) => (
                <li>
                  <span class="lp-pricing__feature-icon">✓</span>
                  {f}
                </li>
              ))}
            </ul>
            <div class="lp-pricing__footer">
              <a href="#kontakt" class="lp-btn lp-btn--primary">Zamów konfigurator</a>
              <a href={pricingPlan.demoUrl} target="_blank" rel="noopener" class="lp-pricing__demo-link">Przetestuj demo →</a>
            </div>
          </div>
        </div>

        <p class="lp-pricing__note">Produkujesz też garaże blaszane? <a href="/konfigurator-garazy/">Konfigurator garaży blaszanych 3D, cennik od 499 PLN/msc</a>.</p>

        <div class="lp-callout">
          <div class="lp-callout__item">
            <span class="lp-callout__icon">➕</span>
            <div>
              <strong>Potrzebujesz dodatkowej opcji?</strong>
              <p>Mogę rozbudować ten konfigurator o funkcje specyficzne dla Twojego asortymentu.</p>
            </div>
          </div>
          <div class="lp-callout__item">
            <span class="lp-callout__icon">🛠️</span>
            <div>
              <strong>Produkujesz coś innego?</strong>
              <p>Buduję konfiguratory 3D na zamówienie pod dowolny produkt.</p>
            </div>
          </div>
          <a href="#kontakt" class="lp-btn lp-btn--secondary">Napisz, wycenię w 24h</a>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="lp-section" id="wdrozenie">
      <div class="container">
        <h2 class="lp-section__title">Jak wygląda wdrożenie?</h2>
        <p class="lp-section__desc">Od pierwszego kontaktu do konfiguratora na Twojej stronie w 5 prostych krokach.</p>
        <div class="lp-steps">
          <div class="lp-step">
            <span class="lp-step__number">1</span>
            <h3>Konsultacja</h3>
            <p>Ustalamy Twój asortyment: typy wiat, materiały, kolory.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">2</span>
            <h3>Personalizacja</h3>
            <p>Konfiguruję logo, kolory i formularz pod Twoją firmę.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">3</span>
            <h3>Testowanie</h3>
            <p>Dostajesz link do testowej wersji, sprawdzasz i zgłaszasz uwagi.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">4</span>
            <h3>Wdrożenie</h3>
            <p>Osadzam konfigurator na Twojej stronie.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">5</span>
            <h3>Wsparcie</h3>
            <p>Aktualizacje i pomoc techniczna przez cały okres abonamentu.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section class="lp-section lp-section--alt">
      <div class="container">
        <h2 class="lp-section__title">Wiata śmietnikowa. Konfigurator online vs cennik PDF</h2>
        <div class="lp-prose">
          <p>
            Producent wiat śmietnikowych z konfiguratorem na stronie zbiera zapytania automatycznie. Klient dobiera <strong>wiatę śmietnikową na wymiar</strong>: liczbę boksów, kolor konstrukcji, materiał wypełnienia, a potem wysyła gotową specyfikację zamiast dzwonić.
          </p>
          <p>
            Wspólnoty mieszkaniowe to kluczowy klient. Zarządca konfiguruje wiatę, generuje wizualizację 3D i przedstawia ją na zebraniu. Zamiast opisywać słowami, pokazuje gotowy projekt z ceną.
          </p>
          <p>
            Konfigurator wiat buduję pod konkretnego <strong>producenta wiat śmietnikowych</strong>, z jego kolorami RAL, typami wypełnień i zakresami wymiarów. Działa w przeglądarce na każdym urządzeniu.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="lp-section" id="faq">
      <div class="container">
        <h2 class="lp-section__title">Najczęstsze pytania o konfigurator wiat</h2>
        <div class="lp-faq">
          {faqItems.map((item) => (
            <details class="lp-faq__item">
              <summary class="lp-faq__question">{item.question}</summary>
              <p class="lp-faq__answer">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Cross-linking -->
    <section class="lp-section lp-section--alt">
      <div class="container" style="text-align: center;">
        <p class="lp-section__desc">Szukasz konfiguratora innego produktu?</p>
        <div class="lp-cta__buttons">
          <a href="/konfigurator-garazy/" class="lp-btn lp-btn--secondary">Konfigurator garaży blaszanych 3D</a>
          <a href="/#uslugi" class="lp-btn lp-btn--secondary">Konfigurator 3D na zamówienie</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="lp-section lp-cta" id="kontakt">
      <div class="container">
        <h2 class="lp-section__title">Chcesz konfigurator wiat na swojej stronie?</h2>
        <p class="lp-section__desc">
          Napisz lub zadzwoń. Pokażę demo i wdrożymy konfigurator w kilka dni.
        </p>
        <div class="lp-cta__buttons">
          <a href={`mailto:${site.contact.email}`} class="lp-btn lp-btn--primary">
            {site.contact.email}
          </a>
          <a href={`tel:${site.contact.phone}`} class="lp-btn lp-btn--secondary">
            {site.contact.phone}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingCTA />
</BaseLayout>

<script>
  import '@/scripts/theme';
  import '@/scripts/smooth-scroll';
  import '@/scripts/scroll-animations';
  import '@/scripts/nav';
  import '@/scripts/particles';
</script>
