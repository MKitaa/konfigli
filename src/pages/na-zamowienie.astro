---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Nav from '@/components/ui/Nav.astro';
import Footer from '@/components/sections/Footer.astro';
import FloatingCTA from '@/components/ui/FloatingCTA.astro';
import { site } from '@/config/site';
import '@/styles/landing-page.css';

const faqItems = [
  { question: 'Ile kosztuje konfigurator na zamówienie?', answer: 'Wyceniam indywidualnie. Opisz produkt, a bezpłatną wycenę dostaniesz w 24h.' },
  { question: 'Jak długo trwa budowa?', answer: '4–8 tygodni, zależnie od złożoności modelu 3D i liczby opcji konfiguracji.' },
  { question: 'Nie mam plików 3D. To problem?', answer: 'Nie. Buduję modele od zera na podstawie rysunków, katalogów lub zdjęć produktu.' },
  { question: 'Czy mogę rozbudować konfigurator później?', answer: 'Tak, nowe warianty, kolory, moduł cenowy, integracja z CRM. Rozliczamy za konkretne zlecenia.' },
  { question: 'Dla jakich produktów można zbudować konfigurator?', answer: 'Każda konstrukcja z wariantami. Jeśli produkt ma wymiary, kolory lub opcje do wyboru, konfigurator ma sens.' },
];

const products = [
  'Hale stalowe',
  'Carporty i wiaty garażowe',
  'Ogrodzenia panelowe',
  'Pergole i zadaszenia',
  'Magazyny blaszane',
  'Kontenery',
  'Domki ogrodowe',
  'Kojce dla zwierząt',
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://konfigli.pl/' },
    { '@type': 'ListItem', position: 2, name: 'Konfigurator 3D na zamówienie' },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Konfigurator 3D na zamówienie',
  description: 'Budowa dedykowanego konfiguratora 3D dla producenta. Model 3D, automatyczna wycena, rysunki techniczne — pod dowolny produkt.',
  provider: {
    '@type': 'ProfessionalService',
    name: 'Konfigli',
    url: 'https://konfigli.pl',
  },
  serviceType: 'Konfigurator produktów 3D',
  areaServed: { '@type': 'Country', name: 'Polska' },
};
---

<BaseLayout
  title="Konfigurator 3D na zamówienie — hale, carporty, ogrodzenia"
  description="Zbuduję konfigurator 3D pod Twój produkt. Hale stalowe, carporty, ogrodzenia, pergole — model 3D z automatyczną wyceną i rysunkami technicznymi. Wycena w 24h."
  showHomeSchemas={false}
  keywords={[
    'konfigurator 3D na zamówienie',
    'konfigurator produktów 3D',
    'dedykowany konfigurator 3D',
    'konfigurator hal stalowych',
    'konfigurator ogrodzeń panelowych',
    'konfigurator carportów',
    'konfigurator na stronę producenta',
    'wizualizacja 3D produktu',
    'konfigurator produktu na zamówienie',
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>
  <Nav />
  <main>
    <!-- Hero -->
    <section class="lp-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="lp-breadcrumb">
          <ol>
            <li><a href="/">Konfigli</a></li>
            <li aria-current="page">Konfigurator na zamówienie</li>
          </ol>
        </nav>
        <span class="lp-badge">Na zamówienie</span>
        <h1 class="lp-hero__title">
          Konfigurator 3D<br />
          <span class="gradient-text">pod Twój produkt</span>
        </h1>
        <p class="lp-hero__subtitle">
          Produkujesz hale, carporty, ogrodzenia lub coś zupełnie innego? Zbuduję konfigurator 3D dopasowany do Twojego asortymentu, z Twoimi kolorami, wymiarami i logiką cenową.
        </p>
        <div class="lp-hero__actions">
          <a href="#kontakt" class="lp-btn lp-btn--primary">Bezpłatna wycena w 24h</a>
          <a href="/#konfigurator" class="lp-btn lp-btn--secondary">Zobacz przykładowe demo</a>
        </div>
      </div>
    </section>

    <!-- What I build -->
    <section class="lp-section lp-section--alt">
      <div class="container">
        <h2 class="lp-section__title">Konfigurator, który sprzedaje zamiast Ciebie</h2>
        <p class="lp-section__desc">Klient projektuje produkt sam, wysyła gotowe zapytanie z wymiarami i specyfikacją. Ty dostajesz leada, nie pytanie.</p>
        <div class="lp-features">
          <div class="lp-feature">
            <div class="lp-feature__icon">📋</div>
            <h3>Klient przychodzi przygotowany</h3>
            <p>Zapytanie zawiera wymiary, kolory i warianty. Bez rozmowy "a ile to będzie kosztować bez żadnych szczegółów".</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">🕐</div>
            <h3>Pracuje 24/7</h3>
            <p>Klient konfiguruje wieczorem, w weekend, na urlopie. Zapytanie trafia do Ciebie gotowe.</p>
          </div>
          <div class="lp-feature">
            <div class="lp-feature__icon">🏆</div>
            <h3>Wyróżniasz się na tle konkurencji</h3>
            <p>Producent z konfiguratorem 3D wygląda poważniej i nowocześniej niż ten z PDF-em i telefonem.</p>
          </div>
        </div>

        <div class="lp-callout" style="margin-top: var(--space-2xl);">
          <div style="flex: 1;">
            <strong style="color: var(--color-text); display: block; margin-bottom: var(--space-xs);">Buduję konfiguratory m.in. dla:</strong>
            <p style="font-size: var(--text-sm); color: var(--color-text-muted); margin: 0;">
              {products.join(' · ')}
            </p>
          </div>
          <a href="#kontakt" class="lp-btn lp-btn--primary" style="flex-shrink: 0;">Bezpłatna wycena w 24h</a>
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="lp-section lp-section--alt">
      <div class="container">
        <h2 class="lp-section__title">Jak wygląda współpraca?</h2>
        <p class="lp-section__desc">Od pierwszej rozmowy do konfiguratora na Twojej stronie.</p>
        <div class="lp-steps">
          <div class="lp-step">
            <span class="lp-step__number">1</span>
            <h3>Rozmowa o produkcie</h3>
            <p>Opisujesz produkt, warianty i opcje. Ustalam zakres projektu i przygotowuję wycenę.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">2</span>
            <h3>Model 3D i projekt</h3>
            <p>Buduję model 3D i interfejs konfiguratora. Raportuję postępy co tydzień.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">3</span>
            <h3>Testy i poprawki</h3>
            <p>Testujesz konfigurator, zgłaszasz uwagi. Poprawiam do skutku.</p>
          </div>
          <div class="lp-step">
            <span class="lp-step__number">4</span>
            <h3>Wdrożenie i wsparcie</h3>
            <p>Osadzam konfigurator na Twojej stronie. Pomagam po wdrożeniu.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Ready-made configurators cross-link -->
    <section class="lp-section">
      <div class="container" style="text-align:center;">
        <h2 class="lp-section__title">Produkujesz garaże lub wiaty śmietnikowe?</h2>
        <p class="lp-section__desc">Mam gotowe konfiguratory w abonamencie, szybciej i taniej niż budowa od zera.</p>
        <div class="lp-cta__buttons">
          <a href="/konfigurator-garazy/" class="lp-btn lp-btn--secondary">Konfigurator garaży od 499 PLN/msc</a>
          <a href="/konfigurator-wiat-smietnikowych/" class="lp-btn lp-btn--secondary">Konfigurator wiat za 399 PLN/msc</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="lp-section lp-section--alt" id="faq">
      <div class="container">
        <h2 class="lp-section__title">Pytania o konfigurator na zamówienie</h2>
        <div class="lp-faq">
          {faqItems.map((item) => (
            <details class="lp-faq__item">
              <summary class="lp-faq__question">{item.question}</summary>
              <p class="lp-faq__answer">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="lp-section lp-cta" id="kontakt">
      <div class="container">
        <h2 class="lp-section__title">Opisz swój produkt, wycenię w 24h</h2>
        <p class="lp-section__desc">Napisz czego potrzebujesz, a przygotuję bezpłatną wycenę i propozycję konfiguratora.</p>
        <div class="lp-cta__buttons">
          <a href={`mailto:${site.contact.email}`} class="lp-btn lp-btn--primary">{site.contact.email}</a>
          <a href={`tel:${site.contact.phone}`} class="lp-btn lp-btn--secondary">{site.contact.phone}</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingCTA />
</BaseLayout>

<script>
  import '@/scripts/theme';
  import '@/scripts/smooth-scroll';
  import '@/scripts/scroll-animations';
  import '@/scripts/nav';
  import '@/scripts/particles';
</script>
