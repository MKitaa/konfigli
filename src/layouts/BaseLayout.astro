---
import { site } from '@/config/site';
import '@/styles/global.css';
import '@/styles/animations.css';
import '@/styles/utilities.css';

interface Props {
  title?: string;
  description?: string;
  robots?: string;
  showHomeSchemas?: boolean;
  keywords?: string[];
  ogImage?: string;
}

const {
  title = site.name,
  description = site.description,
  robots = 'index, follow',
  showHomeSchemas = true,
  keywords = site.seo.keywords,
  ogImage = `${site.url}/images/og-image.png`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url).href;

const pageTitle = title === site.name
  ? `Konfiguratory 3D na zamówienie dla producentów | ${site.name}`
  : `${title} | ${site.name}`;

// JSON-LD: LocalBusiness
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.description,
  url: site.url,
  logo: `${site.url}/images/favicon.svg`,
  email: site.contact.email,
  telephone: site.contact.phone,
  founder: {
    '@type': 'Person',
    name: site.author,
  },
  areaServed: {
    '@type': 'Country',
    name: 'Polska',
  },
  serviceType: [
    'Konfigurator produktów 3D',
    'Konfigurator garaży blaszanych',
    'Konfigurator wiat śmietnikowych',
    'Konfigurator hal stalowych',
    'Konfigurator ogrodzeń panelowych',
    'Konfigurator carportów',
    'Wizualizacja 3D produktów',
    'Automatyzacja ofertowania dla producenta',
    'Strony internetowe dla producentów',
    'Automatyczne rysunki techniczne',
  ],
  knowsAbout: [
    'Konfiguratory 3D',
    'Konfigurator garaży blaszanych',
    'Konfigurator wiat śmietnikowych',
    'Konfigurator hal stalowych',
    'Konfigurator ogrodzeń panelowych',
    'Konfigurator carportów',
    'Wizualizacja 3D produktów',
    'Automatyzacja ofertowania',
    'Automatyczne rysunki techniczne',
    'Kalkulator garaży blaszanych',
    'Dedykowany konfigurator produktu',
    'Strony internetowe dla producentów',
    'Three.js',
    'WebGL',
  ],
};

// JSON-LD: FAQPage (critical for AI/AEO)
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: site.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

// JSON-LD: Product offerings
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: site.products.map((product, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: product.title,
      description: product.description,
      provider: {
        '@type': 'ProfessionalService',
        name: site.name,
      },
    },
  })),
};

// JSON-LD: HowTo for process section
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Jak powstaje Twój konfigurator 3D',
  description: 'Proces tworzenia konfiguratora produktów 3D od rozmowy po wdrożenie.',
  step: site.process.map((item, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: item.title,
    text: item.description,
  })),
};

// JSON-LD: Review schema for testimonials
const reviewSchema = site.testimonials.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Konfigurator 3D produktów',
  brand: { '@type': 'Brand', name: site.name },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 5,
    reviewCount: site.testimonials.length,
    bestRating: 5,
  },
  review: site.testimonials.map((t) => ({
    '@type': 'Review',
    reviewBody: t.quote,
    author: { '@type': 'Organization', name: t.author },
    reviewRating: {
      '@type': 'Rating',
      ratingValue: 5,
      bestRating: 5,
    },
  })),
} : null;

// JSON-LD: Product with subscription offers
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Konfigurator 3D dla producenta',
  description: 'Konfigurator 3D na zamówienie — garaże blaszane, wiaty śmietnikowe, hale stalowe. Abonament od 399 PLN/msc.',
  brand: { '@type': 'Brand', name: site.name },
  offers: [
    {
      '@type': 'Offer',
      name: 'Konfigurator garaży — Start',
      price: '499',
      priceCurrency: 'PLN',
      unitCode: 'MON',
      url: 'https://konfigli.pl/konfigurator-garazy/#cennik',
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: 'Konfigurator garaży — Pro',
      price: '799',
      priceCurrency: 'PLN',
      unitCode: 'MON',
      url: 'https://konfigli.pl/konfigurator-garazy/#cennik',
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: 'Konfigurator garaży — Premium',
      price: '1199',
      priceCurrency: 'PLN',
      unitCode: 'MON',
      url: 'https://konfigli.pl/konfigurator-garazy/#cennik',
      availability: 'https://schema.org/InStock',
    },
    {
      '@type': 'Offer',
      name: 'Konfigurator wiat śmietnikowych',
      price: '399',
      priceCurrency: 'PLN',
      unitCode: 'MON',
      url: 'https://konfigli.pl/konfigurator-wiat-smietnikowych/#cennik',
      availability: 'https://schema.org/InStock',
    },
  ],
  aggregateRating: site.testimonials.length > 0 ? {
    '@type': 'AggregateRating',
    ratingValue: 5,
    reviewCount: site.testimonials.length,
    bestRating: 5,
  } : undefined,
};

// JSON-LD: WebSite for sitelinks search
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
  inLanguage: 'pl-PL',
};

// JSON-LD: SoftwareApplication
const softwareAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Konfigli — Konfigurator produktów 3D na zamówienie',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'Budowa konfiguratora 3D na zamówienie dla producenta garaży, hal, wiat i konstrukcji stalowych. Model 3D, automatyczna wycena i rysunki techniczne.',
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'PLN',
    lowPrice: '0',
    description: 'Wycena indywidualna. Bezpłatna wycena projektu w 24h.',
  },
  creator: {
    '@type': 'Person',
    name: site.author,
  },
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600;700&display=swap" rel="stylesheet" />

    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content={site.author} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.tagline} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon.svg" />

    <!-- Theme: prevent flash of wrong theme -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('konfigli-theme');
        if (!t) t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {showHomeSchemas && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
        {reviewSchema && <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />}
        <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
