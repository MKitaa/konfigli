---
import { site } from '@/config/site';
---

<div class="floating-cta" id="floating-cta" aria-label="Szybki kontakt mobilny">
  <a
    href={`tel:${site.contact.phone.replace(/\s/g, '')}`}
    class="floating-cta__btn floating-cta__btn--call"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
    </svg>
    Zadzwoń
  </a>
  <a href="#kontakt" class="floating-cta__btn floating-cta__btn--write">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
    </svg>
    Napisz
  </a>
</div>

<style>
  .floating-cta {
    display: none;
  }

  @media (max-width: 767px) {
    .floating-cta {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 99;
      display: flex;
      gap: 1px;
      background: var(--color-border);
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
      transition: transform 0.3s var(--ease-out);
    }

    .floating-cta__btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      padding: 0.875rem;
      font-family: var(--font-body);
      font-size: var(--text-sm);
      font-weight: 600;
      text-decoration: none;
      transition: opacity var(--duration-fast);
    }

    .floating-cta__btn--call {
      background: var(--gradient-accent);
      color: white;
    }

    .floating-cta__btn--call:hover {
      opacity: 0.9;
    }

    .floating-cta__btn--write {
      background: var(--color-bg-card);
      color: var(--color-text);
    }

    .floating-cta__btn--write:hover {
      background: var(--color-bg-card-hover);
    }

    .floating-cta__btn svg {
      flex-shrink: 0;
    }
  }
</style>

<script>
  // Hide floating bar when contact section is visible
  const bar = document.getElementById('floating-cta');
  const kontakt = document.getElementById('kontakt');
  if (bar && kontakt && window.innerWidth < 768) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        bar.style.transform = entry.isIntersecting ? 'translateY(100%)' : 'translateY(0)';
      },
      { threshold: 0.1 },
    );
    observer.observe(kontakt);
  }
</script>
