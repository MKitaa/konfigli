---
interface Props {
  title: string;
  description: string;
  highlights: readonly string[];
  icon: 'globe' | 'cube' | 'app' | 'custom';
  badge?: string | null;
}

const { title, description, highlights, icon, badge } = Astro.props;
---

<div class:list={['service-card', 'card-3d', 'reveal', { 'service-card--featured': !!badge }]}>
  <div class="card-3d-inner service-card__inner">
    <div class="shine-overlay"></div>
    {badge && <span class="service-card__badge">{badge}</span>}
    <div class="service-card__icon">
      {icon === 'cube' && (
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
          <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
          <line x1="12" y1="22.08" x2="12" y2="12" />
        </svg>
      )}
      {icon === 'globe' && (
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <circle cx="12" cy="12" r="10" />
          <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
        </svg>
      )}
      {icon === 'custom' && (
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
      )}
      {icon === 'app' && (
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
          <line x1="8" y1="21" x2="16" y2="21" />
          <line x1="12" y1="17" x2="12" y2="21" />
        </svg>
      )}
    </div>
    <h3 class="service-card__title">{title}</h3>
    <p class="service-card__description">{description}</p>
    <ul class="service-card__highlights">
      {highlights.map((item) => (
        <li class="service-card__highlight">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .service-card {
    position: relative;
  }

  .service-card--featured .service-card__inner {
    border-color: rgba(59, 130, 246, 0.25);
    background: linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.04),
      var(--color-bg-card)
    );
  }

  .service-card__inner {
    position: relative;
    padding: var(--space-2xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    height: 100%;
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .service-card__inner:hover {
    border-color: var(--color-border-hover);
  }

  .service-card__badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    background: rgba(59, 130, 246, 0.1);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-lg);
  }

  .service-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-lg);
    background: rgba(59, 130, 246, 0.1);
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
  }

  .service-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-md);
  }

  .service-card__description {
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  .service-card__highlights {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .service-card__highlight {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .service-card__highlight svg {
    flex-shrink: 0;
    color: var(--color-accent);
    margin-top: 2px;
  }
</style>
