---
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
---

<section class="section" id="realizacje">
  <div class="container">
    <SectionHeading title="Działające wdrożenia u producentów" subtitle="Realizacje" />
    <div class="case-studies">
      {site.caseStudies.map((study, index) => (
        <article
          class:list={[
            'case-study',
            'reveal',
            { 'case-study--inactive': !study.active && !('isPlaceholder' in study && study.isPlaceholder) },
            { 'case-study--reverse': index % 2 !== 0 },
            { 'case-study--placeholder': 'isPlaceholder' in study && study.isPlaceholder },
          ]}
        >
          <div class="case-study__image">
            {'isPlaceholder' in study && study.isPlaceholder ? (
              <div class="case-study__placeholder case-study__placeholder--cta">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                  <line x1="12" y1="5" x2="12" y2="19" />
                  <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                <p class="case-study__placeholder-text">Tu może być Twój projekt</p>
              </div>
            ) : (
              <div class="case-study__browser">
                <div class="case-study__browser-bar">
                  <span class="case-study__browser-dot"></span>
                  <span class="case-study__browser-dot"></span>
                  <span class="case-study__browser-dot"></span>
                  <span class="case-study__browser-url">{study.url !== '#' ? study.url : '—'}</span>
                </div>
                <a
                  href={study.url !== '#kontakt' ? study.url : undefined}
                  target={study.url !== '#kontakt' ? '_blank' : undefined}
                  rel={study.url !== '#kontakt' ? 'noopener noreferrer' : undefined}
                  class="case-study__browser-content"
                >
                  {study.image ? (
                    <img
                      src={study.image}
                      alt={`${study.title} — konfigurator 3D na stronie producenta`}
                      loading="lazy"
                      class="case-study__screenshot"
                    />
                  ) : (
                    <div class="case-study__screenshot-placeholder">
                      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                        <circle cx="8.5" cy="8.5" r="1.5" />
                        <polyline points="21 15 16 10 5 21" />
                      </svg>
                      <span>Zrzut ekranu wkrótce</span>
                    </div>
                  )}
                </a>
              </div>
            )}
            {study.badge && (
              <span class:list={[
                'case-study__badge',
                { 'case-study__badge--primary': 'isPlaceholder' in study && study.isPlaceholder },
              ]}>{study.badge}</span>
            )}
          </div>
          <div class="case-study__content">
            <h3 class="case-study__title">{study.title}</h3>
            <p class="case-study__subtitle-text">{study.subtitle}</p>
            <p class="case-study__description">{study.description}</p>
            <h4 class="case-study__results-heading">
              {'isPlaceholder' in study && study.isPlaceholder ? 'Co dostajesz:' : 'Efekty:'}
            </h4>
            <ul class="case-study__results">
              {study.results.map((result) => (
                <li class="case-study__result">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                  {result}
                </li>
              ))}
            </ul>
            {'isPlaceholder' in study && study.isPlaceholder ? (
              <Button href="#kontakt" variant="primary" size="sm">
                Porozmawiajmy o Twoim projekcie
              </Button>
            ) : study.active && (
              <Button href={study.url} variant="secondary" size="sm" target="_blank">
                Odwiedź stronę
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </Button>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .case-studies {
    display: flex;
    flex-direction: column;
    gap: clamp(5rem, 4rem + 4vw, 8rem);
  }

  .case-study {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .case-study--reverse {
    direction: rtl;
  }

  .case-study--reverse > * {
    direction: ltr;
  }

  .case-study--inactive {
    opacity: 0.6;
  }

  .case-study--placeholder .case-study__image {
    border-style: dashed;
    border-width: 2px;
    border-color: rgba(249, 115, 22, 0.3);
  }

  .case-study__image {
    position: relative;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.4s var(--ease-out),
                transform 0.4s var(--ease-out);
  }

  .case-study__image:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  /* Browser frame mockup */
  .case-study__browser {
    background: var(--color-bg-card);
  }

  .case-study__browser-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .case-study__browser-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .case-study__browser-dot:first-child {
    background: #ef4444;
  }

  .case-study__browser-dot:nth-child(2) {
    background: #eab308;
  }

  .case-study__browser-dot:nth-child(3) {
    background: #22c55e;
  }

  .case-study__browser-url {
    margin-left: 8px;
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    font-family: var(--font-body);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .case-study__browser-content {
    display: block;
    overflow: hidden;
    background: var(--color-bg-dark);
    text-decoration: none;
    cursor: pointer;
  }

  .case-study__screenshot {
    width: 100%;
    display: block;
    transition: transform 0.6s var(--ease-out);
  }

  .case-study__image:hover .case-study__screenshot {
    transform: scale(1.03);
  }

  .case-study__screenshot-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    color: var(--color-text-dim);
    font-size: var(--text-xs);
  }

  /* CTA placeholder card */
  .case-study__placeholder {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .case-study__placeholder--cta {
    aspect-ratio: 16 / 9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    background: var(--color-bg-card);
    color: var(--color-accent);
  }

  .case-study__placeholder-text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-dim);
  }

  .case-study__badge {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    padding: 0.25rem 0.75rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-dim);
    background: rgba(100, 116, 139, 0.15);
    border: 1px solid rgba(100, 116, 139, 0.25);
    border-radius: var(--radius-sm);
    z-index: 1;
  }

  .case-study__badge--primary {
    color: var(--color-accent);
    background: rgba(249, 115, 22, 0.15);
    border-color: rgba(249, 115, 22, 0.25);
  }

  .case-study__title {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-xs);
  }

  .case-study__subtitle-text {
    font-size: var(--text-sm);
    color: var(--color-text-dim);
    margin-bottom: var(--space-lg);
  }

  .case-study__description {
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  .case-study__results-heading {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .case-study__results {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .case-study__result {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .case-study__result svg {
    flex-shrink: 0;
    color: var(--color-accent);
    margin-top: 2px;
  }

  @media (max-width: 768px) {
    .case-study {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .case-study--reverse {
      direction: ltr;
    }
  }

  @media (max-width: 640px) {
    .case-studies {
      gap: var(--space-3xl);
    }

    .case-study {
      gap: var(--space-lg);
    }

    .case-study__title {
      font-size: var(--text-xl);
    }

    .case-study__browser-bar {
      padding: 8px 12px;
    }

    .case-study__browser-dot {
      width: 8px;
      height: 8px;
    }
  }
</style>
