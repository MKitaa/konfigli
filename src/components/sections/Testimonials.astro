---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
---

<section class="section testimonials">
  <div class="container">
    <SectionHeading title="Producenci, z którymi pracuję" subtitle="Opinie" />
    <div class="testimonials__grid">
      {site.testimonials.map((t) => (
        <blockquote class="testimonial reveal--scale">
          <p class="testimonial__text">{t.quote}</p>
          <footer class="testimonial__footer">
            <div class="testimonial__avatar">
              <span>{t.author.charAt(0)}</span>
            </div>
            <div>
              <cite class="testimonial__author">{t.author}</cite>
              <p class="testimonial__role">{t.role}</p>
            </div>
          </footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: linear-gradient(to bottom, var(--color-bg), rgba(249, 115, 22, 0.015), var(--color-bg));
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2xl);
    max-width: 900px;
    margin-inline: auto;
  }

  .testimonial {
    position: relative;
    background: linear-gradient(135deg, var(--color-bg-card), var(--color-bg-elevated));
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: var(--space-2xl) var(--space-xl) var(--space-xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: var(--shadow-sm);
  }

  .testimonial::before {
    content: '\201C';
    position: absolute;
    top: var(--space-md);
    left: var(--space-xl);
    font-family: var(--font-heading);
    font-size: 4rem;
    line-height: 1;
    color: var(--color-accent);
    opacity: 0.15;
    pointer-events: none;
  }

  .testimonial__text {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: var(--space-lg);
  }

  .testimonial__footer {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .testimonial__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(249, 115, 22, 0.1);
    border: 1px solid rgba(249, 115, 22, 0.2);
    flex-shrink: 0;
  }

  .testimonial__avatar span {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .testimonial__author {
    display: block;
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .testimonial__role {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  @media (max-width: 768px) {
    .testimonials__grid {
      grid-template-columns: 1fr;
      max-width: 500px;
      margin-inline: auto;
    }
  }
</style>
