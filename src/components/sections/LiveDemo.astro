---
import Button from '@/components/ui/Button.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
---

<section class="section live-demo" id="demo">
  <div class="container">
    <SectionHeading
      title={site.liveDemo.title}
      subtitle="Na żywo"
    />
    <p class="live-demo__description reveal">{site.liveDemo.description}</p>

    <div class="live-demo__frame-wrapper reveal">
      <div class="live-demo__frame">
        <iframe
          src={site.liveDemo.url}
          title="Konfigurator garaży — demo na żywo"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope"
        ></iframe>
      </div>
      <div class="live-demo__cta">
        <p class="live-demo__cta-text">
          {site.liveDemo.cta}
        </p>
        <Button href="#kontakt" variant="primary">
          Porozmawiajmy o Twoim produkcie
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .live-demo__description {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-3xl);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .live-demo__frame-wrapper {
    max-width: 960px;
    margin-inline: auto;
  }

  .live-demo__frame {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    aspect-ratio: 16 / 10;
  }

  .live-demo__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .live-demo__cta {
    text-align: center;
    margin-top: var(--space-2xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
  }

  .live-demo__cta-text {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-text);
  }
</style>
