---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
---

<section class="section" id="faq">
  <div class="container">
    <SectionHeading title="Odpowiedzi na Twoje pytania" subtitle="FAQ" />
    <div class="faq-list">
      {site.faq.map((item) => (
        <details class="faq-item reveal">
          <summary class="faq-item__question">
            <span>{item.question}</span>
            <svg class="faq-item__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9" />
            </svg>
          </summary>
          <div class="faq-item__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <div class="faq__cta">
      <p>Nie znalazłeś odpowiedzi?</p>
      <a href="#kontakt" class="faq__cta-btn">Napisz do mnie, odpowiem w 24h →</a>
    </div>
  </div>
</section>

<style>
  .faq__cta {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  .faq__cta p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .faq__cta-btn {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    transition: color var(--duration-normal) var(--ease-out),
                gap var(--duration-normal) var(--ease-out);
  }

  .faq__cta-btn:hover {
    color: var(--color-accent-secondary);
    gap: var(--space-sm);
  }
  .faq-list {
    max-width: 720px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .faq-item {
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    overflow: hidden;
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .faq-item[open] {
    border-bottom-color: rgba(249, 115, 22, 0.25);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-xl);
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--color-text);
    list-style: none;
    user-select: none;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__question::marker {
    display: none;
    content: '';
  }

  .faq-item__chevron {
    flex-shrink: 0;
    color: var(--color-text-dim);
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .faq-item[open] .faq-item__chevron {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    padding: 0 var(--space-xl) var(--space-lg);
  }

  .faq-item__answer p {
    font-size: var(--text-sm);
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .faq-item__question {
      padding: var(--space-md) var(--space-lg);
      font-size: var(--text-sm);
    }

    .faq-item__answer {
      padding: 0 var(--space-lg) var(--space-md);
    }
  }
</style>
