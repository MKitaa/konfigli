---
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
---

<section class="hero" id="hero">
  <canvas
    class="hero__canvas"
    id="hero-canvas"
    role="img"
    aria-label="Interaktywna scena 3D z modelem garażu"
  ></canvas>

  <div class="hero__fallback" id="hero-fallback" aria-hidden="true"></div>

  <div class="container hero__content">
    <div class="hero__text">
      <p class="hero__eyebrow">Konfiguratory 3D dla producentów</p>
      <h1 class="hero__title">
        <span class="hero__title-line">Twoi klienci konfigurują.</span>
        <span class="hero__title-line"><span class="gradient-text">Ty sprzedajesz.</span></span>
      </h1>
      <p class="hero__subtitle">
        Buduję konfiguratory 3D na zamówienie. Klient sam dobiera wymiary, kolor i wariant w przeglądarce, a Ty dostajesz gotowe zapytanie. Gotowe rozwiązania dla garaży i wiat, albo konfigurator pod Twój produkt.
      </p>
      <div class="hero__actions">
        <Button href="#uslugi" variant="primary" size="lg">
          Zobacz ofertę
        </Button>
        <Button href="#konfigurator" variant="secondary" size="lg">
          Wypróbuj demo
        </Button>
      </div>
      <div class="hero__metrics">
        <div class="hero__metric">
          <span class="hero__metric-value">24/7</span>
          <span class="hero__metric-label">Zapytania ofertowe</span>
        </div>
        <div class="hero__metric">
          <span class="hero__metric-value">24h</span>
          <span class="hero__metric-label">bezpłatna wycena</span>
        </div>
        <div class="hero__metric">
          <span class="hero__metric-value">3</span>
          <span class="hero__metric-label">wdrożone konfiguratory</span>
        </div>
      </div>
    </div>
  </div>

  <div class="hero__scroll-indicator" aria-hidden="true">
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 100%;
    background: radial-gradient(ellipse at 20% 50%, rgba(249, 115, 22, 0.04) 0%, transparent 70%);
    z-index: 0;
    pointer-events: none;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__fallback {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 70% 50%, rgba(249, 115, 22, 0.06) 0%, transparent 60%),
      radial-gradient(ellipse at 30% 70%, rgba(251, 146, 60, 0.04) 0%, transparent 50%);
  }

  .hero__fallback.is-visible {
    display: block;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: var(--nav-height);
  }

  .hero__text {
    max-width: 720px;
  }

  .hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-lg);
    padding-left: var(--space-md);
    border-left: 2px solid var(--color-accent);
  }

  .hero__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-xl);
  }

  .hero__title-line {
    display: block;
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    max-width: 520px;
    margin-bottom: var(--space-2xl);
    line-height: 1.75;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .hero__metrics {
    display: flex;
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    position: relative;
  }

  .hero__metrics::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 50%;
    height: 1px;
    background: linear-gradient(to right, var(--color-accent), transparent);
    opacity: 0.3;
  }

  .hero__metric {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .hero__metric-value {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--color-accent);
    line-height: 1.2;
  }

  .hero__metric-label {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    line-height: 1.4;
  }

  .hero__scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .hero__scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.5); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 768px) {
    .hero__text {
      max-width: 100%;
    }

    .hero__canvas {
      opacity: 0.15;
      transform: scale(0.8);
      transform-origin: top right;
    }
  }

  @media (max-width: 640px) {
    .hero__title {
      font-size: clamp(1.75rem, 1.2rem + 2.75vw, 2.5rem);
    }

    .hero__subtitle {
      font-size: var(--text-base);
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__eyebrow {
      font-size: var(--text-xs);
    }

    .hero__metrics {
      gap: var(--space-lg);
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .hero__metrics::-webkit-scrollbar {
      display: none;
    }

    .hero__metric {
      min-width: 0;
      flex-shrink: 0;
    }

    .hero__metric-value {
      font-size: var(--text-xl);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { initHeroScene } from '@/components/three/HeroScene';

  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const fallback = document.getElementById('hero-fallback');

  if (canvas) {
    try {
      initHeroScene(canvas);
    } catch {
      canvas.style.display = 'none';
      fallback?.classList.add('is-visible');
    }
  }

  // Staggered hero entrance
  const hero = document.querySelector('.hero') as HTMLElement;
  if (hero) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = [
      '.hero__eyebrow',
      '.hero__title',
      '.hero__subtitle',
      '.hero__actions',
      '.hero__metrics',
    ].map((s) => hero.querySelector(s)).filter(Boolean);

    if (prefersReduced) {
      targets.forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
    } else {
      gsap.to(targets, {
        opacity: 1,
        y: 0,
        duration: 0.9,
        ease: 'power3.out',
        stagger: 0.12,
        delay: 0.3,
      });
    }
  }
</script>
