---
import Button from '@/components/ui/Button.astro';
import { site } from '@/config/site';
---

<section class="hero" id="hero">
  <canvas
    class="hero__canvas"
    id="hero-canvas"
    role="img"
    aria-label="Interaktywna scena 3D z modelem garażu"
  ></canvas>

  <div class="hero__fallback" id="hero-fallback" aria-hidden="true"></div>

  <div class="container hero__content">
    <div class="hero__text">
      <p class="hero__eyebrow">Konfiguratory 3D &middot; Strony internetowe &middot; Aplikacje webowe</p>
      <h1 class="hero__title">
        <span class="hero__title-line">Klient konfiguruje produkt sam.</span>
        <span class="hero__title-line"><span class="gradient-text">Ty dostajesz zamówienie.</span></span>
      </h1>
      <p class="hero__subtitle">
        Buduję konfiguratory z podglądem 3D i strony internetowe dla producentów garaży, wiat, pergoli, carportów i innych konstrukcji. Twój klient sam dobiera wariant i wysyła zapytanie — bez telefonu do Ciebie.
      </p>
      <div class="hero__actions">
        <Button href="#kontakt" variant="primary" size="lg">
          Bezpłatna wycena w 24h
        </Button>
        <Button href="#demo" variant="secondary" size="lg">
          Zobacz konfigurator na żywo
        </Button>
      </div>
    </div>
  </div>

  <div class="hero__scroll-indicator" aria-hidden="true">
    <div class="hero__scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero__fallback {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(ellipse at 70% 50%, rgba(59, 130, 246, 0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 30% 70%, rgba(139, 92, 246, 0.05) 0%, transparent 50%);
  }

  .hero__fallback.is-visible {
    display: block;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: var(--nav-height);
  }

  .hero__text {
    max-width: 720px;
  }

  .hero__eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-lg);
  }

  .hero__title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-xl);
  }

  .hero__title-line {
    display: block;
  }

  .hero__subtitle {
    font-size: var(--text-lg);
    max-width: 520px;
    margin-bottom: var(--space-2xl);
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero__scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
  }

  .hero__scroll-line {
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, var(--color-accent), transparent);
    animation: scroll-pulse 2s ease-in-out infinite;
  }

  @keyframes scroll-pulse {
    0%, 100% { opacity: 0.3; transform: scaleY(0.5); transform-origin: top; }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 640px) {
    .hero__title {
      font-size: clamp(1.75rem, 1.2rem + 2.75vw, 2.5rem);
    }

    .hero__actions {
      flex-direction: column;
    }
  }
</style>

<script>
  import { initHeroScene } from '@/components/three/HeroScene';

  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const fallback = document.getElementById('hero-fallback');

  if (canvas) {
    try {
      initHeroScene(canvas);
    } catch {
      canvas.style.display = 'none';
      fallback?.classList.add('is-visible');
    }
  }
</script>
