---
import { site } from '@/config/site';
---

<footer class="footer">
  <div class="container footer__container">
    <div class="footer__brand">
      <a href="/" class="footer__logo">
        <img src="/images/logo-dark.svg" alt={site.name} class="footer__logo-img footer__logo-img--dark" width="220" height="52" />
        <img src="/images/logo-light.svg" alt={site.name} class="footer__logo-img footer__logo-img--light" width="220" height="52" />
      </a>
      <p class="footer__tagline">{site.tagline}</p>
    </div>

    <nav class="footer__nav" aria-label="Linki w stopce">
      <ul class="footer__links" role="list">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} class="footer__link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer__contact">
      <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="footer__contact-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
        </svg>
        {site.contact.phone}
      </a>
      <a href={`mailto:${site.contact.email}`} class="footer__contact-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
        {site.contact.email}
      </a>
    </div>

    <nav class="footer__extra-links" aria-label="Konfiguratory">
      <a href="/konfigurator-garazy/" class="footer__link">Konfigurator garaży blaszanych</a>
      <a href="/konfigurator-wiat-smietnikowych/" class="footer__link">Konfigurator wiat śmietnikowych</a>
      <a href="/na-zamowienie/" class="footer__link">Konfigurator na zamówienie</a>
    </nav>

    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {new Date().getFullYear()} {site.name} &middot; {site.business.fullName}
        &middot; NIP: {site.business.nip}
        &middot; <a href="/polityka-prywatnosci/" class="footer__copy-link">Polityka prywatności</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: none;
    padding-block: var(--space-4xl) var(--space-2xl);
    position: relative;
  }

  .footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(200px, 40%);
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-accent), transparent);
    opacity: 0.3;
  }

  .footer__container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xl);
    text-align: center;
  }

  .footer__logo {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .footer__logo:hover {
    opacity: 0.8;
  }

  .footer__logo-img {
    height: 56px;
    width: auto;
  }

  .footer__logo-img--light { display: none; }
  .footer__logo-img--dark { display: block; }

  :global([data-theme="light"]) .footer__logo-img--light { display: block; }
  :global([data-theme="light"]) .footer__logo-img--dark { display: none; }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-dim);
    margin-top: var(--space-xs);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: var(--color-text-dim);
    text-decoration: none;
    position: relative;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .footer__link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width var(--duration-normal) var(--ease-out), left var(--duration-normal) var(--ease-out);
  }

  .footer__link:hover {
    color: var(--color-text);
  }

  .footer__link:hover::after {
    width: 100%;
    left: 0;
  }

  .footer__contact {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
    justify-content: center;
  }

  .footer__contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .footer__contact-link:hover {
    color: var(--color-accent);
  }

  .footer__bottom {
    padding-top: var(--space-xl);
    width: 100%;
    position: relative;
  }

  .footer__bottom::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-border), transparent);
  }

  .footer__extra-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
  }

  .footer__copy {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  .footer__copy-link {
    color: var(--color-text-dim);
    text-decoration: none;
    transition: color var(--duration-normal) var(--ease-out);
  }

  .footer__copy-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .footer {
      padding-block: var(--space-2xl) var(--space-lg);
    }

    .footer__container {
      gap: var(--space-lg);
    }

    .footer__links {
      gap: var(--space-md);
    }
  }
</style>
