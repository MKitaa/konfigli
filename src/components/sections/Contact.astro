      } catch (err) {
        status.textContent = 'Nie udało się wysłać. Spróbuj ponownie lub napisz na biuro@konfigli.pl';
        status.className = 'form__status form__status--error';
      } finally {
        submitBtn.disabled = false;
        submitText.textContent = 'Wyślij zapytanie';
      }
    });
  }

