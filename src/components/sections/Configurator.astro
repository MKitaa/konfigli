---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';

const featured = site.configurator.demos[0];
const otherDemos = site.configurator.demos.slice(1);
---

<section class="section configurator" id="konfigurator">
  <div class="container">
    <SectionHeading
      title={site.configurator.title}
      subtitle={site.configurator.subtitle}
    />
    <p class="configurator__description reveal">{site.configurator.description}</p>

    <div class="configurator__stats reveal">
      {site.configurator.stats.map((stat) => (
        <div class="configurator__stat">
          <span class="configurator__stat-value">
            <span data-count-target={stat.value}>0</span>{stat.suffix}
          </span>
          <span class="configurator__stat-label">{stat.label}</span>
        </div>
      ))}
    </div>

    <!-- Featured demo with live iframe -->
    <div class="configurator__featured reveal">
      <div class="configurator__featured-header">
        <div class="configurator__featured-info">
          {featured.badge && <span class="configurator__badge">{featured.badge}</span>}
          <h3 class="configurator__featured-title">{featured.title}</h3>
          <p class="configurator__featured-desc">{featured.description}</p>
        </div>
        <a
          href={featured.url}
          target="_blank"
          rel="noopener noreferrer"
          class="configurator__featured-btn"
        >
          Otwórz na pełnym ekranie
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </a>
      </div>
      <div class="configurator__iframe-wrap">
        <iframe
          src={featured.url}
          title={`${featured.title} — demo na żywo`}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope"
        ></iframe>
      </div>
    </div>

    <!-- Other demos -->
    <div class="configurator__others reveal">
      {otherDemos.map((demo) => (
        <div class="configurator__other-card">
          <div class="configurator__other-icon">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
              <polyline points="3.27 6.96 12 12.01 20.73 6.96" />
              <line x1="12" y1="22.08" x2="12" y2="12" />
            </svg>
          </div>
          <div class="configurator__other-content">
            <h4 class="configurator__other-title">{demo.title}</h4>
            <p class="configurator__other-desc">{demo.description}</p>
          </div>
          <a
            href={demo.url}
            target={demo.url !== '#' ? '_blank' : undefined}
            rel={demo.url !== '#' ? 'noopener noreferrer' : undefined}
            class:list={['configurator__other-btn', { 'configurator__other-btn--disabled': demo.url === '#' }]}
          >
            {demo.url !== '#' ? 'Otwórz demo' : 'Wkrótce'}
            {demo.url !== '#' && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17L17 7M17 7H7M17 7v10" />
              </svg>
            )}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .configurator {
    position: relative;
  }

  .configurator::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(249, 115, 22, 0.03) 0%, transparent 50%);
    pointer-events: none;
  }

  .configurator__description {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-2xl);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .configurator__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    max-width: 560px;
    margin-inline: auto;
    margin-bottom: var(--space-3xl);
    text-align: center;
  }

  .configurator__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .configurator__stat-value {
    font-family: var(--font-body);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--color-accent);
  }

  .configurator__stat-label {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    line-height: 1.4;
  }

  /* Featured demo */
  .configurator__featured {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background: var(--color-bg-card);
    overflow: hidden;
    margin-bottom: var(--space-xl);
    box-shadow: var(--shadow-md);
  }

  .configurator__featured-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .configurator__featured-info {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .configurator__badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    background: var(--color-accent-light);
    border: 1px solid var(--color-border-hover);
    border-radius: var(--radius-sm);
  }

  .configurator__featured-title {
    font-size: var(--text-lg);
  }

  .configurator__featured-desc {
    display: none;
  }

  .configurator__featured-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    flex-shrink: 0;
    padding: 0.5rem 1.25rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    color: white;
    background: var(--gradient-accent);
    border-radius: var(--radius-md);
    text-decoration: none;
    box-shadow: var(--shadow-accent);
    border-radius: var(--radius-full);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .configurator__featured-btn:hover {
    transform: translateY(-1px) scale(1.01);
    box-shadow: 0 8px 30px rgba(249, 115, 22, 0.35);
  }

  .configurator__iframe-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-dark);
  }

  .configurator__iframe-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Other demos — horizontal cards */
  .configurator__others {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .configurator__other-card {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-2xl);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out);
  }

  .configurator__other-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--shadow-md);
  }

  .configurator__other-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--color-accent-light);
    color: var(--color-accent);
  }

  .configurator__other-content {
    flex-grow: 1;
    min-width: 0;
  }

  .configurator__other-title {
    font-size: var(--text-base);
    margin-bottom: var(--space-xs);
  }

  .configurator__other-desc {
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--color-text-dim);
  }

  .configurator__other-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    flex-shrink: 0;
    padding: 0.5rem 1rem;
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .configurator__other-btn:hover {
    border-color: var(--color-border-hover);
    background: var(--color-accent-light);
  }

  .configurator__other-btn--disabled {
    color: var(--color-text-dim);
    cursor: default;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .configurator__featured-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .configurator__featured-desc {
      display: block;
      font-size: var(--text-sm);
      line-height: 1.6;
      color: var(--color-text-muted);
    }
  }

  @media (max-width: 768px) {
    .configurator__others {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .configurator__stats {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }

    .configurator__featured-header {
      padding: var(--space-lg);
    }

    .configurator__featured-title {
      font-size: var(--text-base);
    }

    .configurator__featured-btn {
      width: 100%;
      justify-content: center;
      padding: 0.75rem 1.25rem;
      font-size: var(--text-base);
    }

    .configurator__iframe-wrap {
      aspect-ratio: unset;
      height: 70vh;
      min-height: 320px;
      max-height: 600px;
    }

    .configurator__other-card {
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-lg);
    }
  }

  @media (max-width: 380px) {
    .configurator__stats {
      gap: var(--space-md);
    }

    .configurator__stat-value {
      font-size: var(--text-xl);
    }
  }
</style>
