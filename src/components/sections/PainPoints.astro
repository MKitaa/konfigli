---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
---

<section class="section pain-points">
  <div class="container">
    <SectionHeading title={site.painPoints.title} subtitle="Codzienność producenta" />

    <div class="pain-points__grid">
      {site.painPoints.problems.map((problem) => (
        <div class="pain-card reveal">
          <div class="pain-card__icon">
            {problem.icon === 'phone' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
              </svg>
            )}
            {problem.icon === 'pdf' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <polyline points="14 2 14 8 20 8" />
                <line x1="16" y1="13" x2="8" y2="13" />
                <line x1="16" y1="17" x2="8" y2="17" />
              </svg>
            )}
            {problem.icon === 'clock' && (
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            )}
          </div>
          <h3 class="pain-card__title">{problem.title}</h3>
          <p class="pain-card__description">{problem.description}</p>
        </div>
      ))}
    </div>

    <div class="comparison reveal">
      <div class="comparison__header">
        <div class="comparison__corner"></div>
        <div class="comparison__col comparison__col--before">Bez konfiguratora</div>
        <div class="comparison__col comparison__col--after">Z konfiguratorem</div>
      </div>
      <div class="comparison__row">
        <span class="comparison__metric">Zapytania ofertowe</span>
        <span class="comparison__before">Ogólne, niekompletne</span>
        <span class="comparison__after">Z kompletną specyfikacją</span>
      </div>
      <div class="comparison__row">
        <span class="comparison__metric">Dostępność oferty</span>
        <span class="comparison__before">Pn–Pt, 8–16</span>
        <span class="comparison__after">24/7</span>
      </div>
      <div class="comparison__row">
        <span class="comparison__metric">Przygotowanie oferty</span>
        <span class="comparison__before">~30 min ręcznie</span>
        <span class="comparison__after">Kilka minut</span>
      </div>
      <div class="comparison__row comparison__row--last">
        <span class="comparison__metric">Prezentacja produktu</span>
        <span class="comparison__before">PDF / katalog</span>
        <span class="comparison__after">Interaktywny 3D</span>
      </div>
    </div>

    <div class="pain-points__cta">
      <a href="#konfigurator" class="pain-points__cta-btn">Sprawdź gotowe demo →</a>
    </div>
  </div>
</section>

<style>
  .pain-points__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .pain-card {
    padding: var(--space-xl);
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: var(--color-bg-card);
    position: relative;
    overflow: hidden;
    transition: box-shadow var(--duration-normal) var(--ease-out);
  }

  .pain-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--space-xl);
    width: 30px;
    height: 2px;
    background: var(--color-warning);
  }

  .pain-card:hover {
    box-shadow: var(--shadow-md);
  }

  .pain-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: rgba(239, 68, 68, 0.1);
    color: var(--color-warning);
    margin-bottom: var(--space-md);
  }

  .pain-card__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .pain-card__description {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .pain-points__cta {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  .pain-points__cta-btn {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    transition: color var(--duration-normal) var(--ease-out),
                gap var(--duration-normal) var(--ease-out);
  }

  .pain-points__cta-btn:hover {
    color: var(--color-accent-secondary);
    gap: var(--space-sm);
  }

  /* ---- Comparison table ---- */
  .comparison {
    margin-top: var(--space-3xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    background: var(--color-bg-card);
    box-shadow: var(--shadow-sm);
  }

  .comparison__header {
    display: grid;
    grid-template-columns: 200px 1fr 1fr;
    border-bottom: 1px solid var(--color-border);
  }

  .comparison__corner {
    background: var(--color-bg-elevated);
    border-right: 1px solid var(--color-border);
  }

  .comparison__col {
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: center;
  }

  .comparison__col--before {
    color: var(--color-warning);
    background: rgba(239, 68, 68, 0.05);
  }

  .comparison__col--after {
    color: var(--color-accent);
    background: var(--color-accent-light);
  }

  .comparison__row {
    display: grid;
    grid-template-columns: 200px 1fr 1fr;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-fast);
  }

  .comparison__row--last {
    border-bottom: none;
  }

  .comparison__row:hover {
    background: var(--color-bg-elevated);
  }

  .comparison__metric {
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    border-right: 1px solid var(--color-border);
  }

  .comparison__before {
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-text-dim);
    text-align: center;
  }

  .comparison__after {
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 600;
    text-align: center;
  }

  @media (max-width: 768px) {
    .pain-points__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .pain-card {
      padding: var(--space-lg);
    }

    .comparison__header {
      display: none;
    }

    .comparison__row {
      grid-template-columns: 1fr;
      gap: var(--space-xs);
      padding: var(--space-lg);
    }

    .comparison__metric {
      border-right: none;
      padding: 0;
      font-size: var(--text-xs);
      color: var(--color-text-dim);
      margin-bottom: var(--space-xs);
    }

    .comparison__before,
    .comparison__after {
      text-align: left;
      padding: 0;
      font-size: var(--text-sm);
    }

    .comparison__before {
      text-decoration: line-through;
      opacity: 0.5;
      display: inline;
    }

    .comparison__before::after {
      content: ' → ';
      text-decoration: none;
      color: var(--color-accent);
      font-weight: 700;
    }

    .comparison__after {
      display: inline;
    }
  }

  @media (max-width: 480px) {
    .pain-card__title {
      font-size: var(--text-base);
    }

    .comparison__row {
      padding: var(--space-md);
    }

    .comparison__before,
    .comparison__after {
      font-size: var(--text-xs);
    }
  }
</style>
