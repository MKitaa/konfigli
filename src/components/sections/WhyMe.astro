---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';

const icons = ['direct', 'clock', 'transparent', 'support'] as const;
---

<section class="section why-me" id="dlaczego">
  <div class="container">
    <SectionHeading title="Dlaczego warto ze mną pracować" subtitle="Gwarancje" />
    <div class="why-me__grid">
      {site.whyMe.map((item, i) => (
        <div class="why-me__card reveal">
          <div class="why-me__icon">
            {icons[i] === 'direct' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
              </svg>
            )}
            {icons[i] === 'clock' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            )}
            {icons[i] === 'transparent' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                <polyline points="9 12 11 14 15 10" />
              </svg>
            )}
            {icons[i] === 'support' && (
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
                <line x1="4" y1="22" x2="4" y2="15" />
              </svg>
            )}
          </div>
          <h3 class="why-me__title">{item.title}</h3>
          <p class="why-me__description">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-me__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--space-xl);
  }

  .why-me__card {
    text-align: center;
    padding: var(--space-xl);
  }

  .why-me__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(59, 130, 246, 0.1);
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
  }

  .why-me__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .why-me__description {
    font-size: var(--text-sm);
    line-height: 1.7;
  }
</style>
