---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { site } from '@/config/site';
---

<section class="section" id="proces">
  <div class="container">
    <SectionHeading title="Jak wygląda wdrożenie?" subtitle="Proces" />
    <div class="process">
      {site.process.map((item, i) => (
        <>
          <div class="process__step reveal">
            <span class="process__number">{i + 1}</span>
            <h3 class="process__title">{item.title}</h3>
            <p class="process__desc">{item.description}</p>
          </div>
          {i < site.process.length - 1 && (
            <div class="process__arrow" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </div>
          )}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .process {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr auto 1fr;
    gap: var(--space-lg);
    align-items: start;
    margin-top: var(--space-2xl);
  }

  .process__step {
    text-align: center;
  }

  .process__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-accent-light);
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .process__title {
    font-size: var(--text-base);
    margin-bottom: var(--space-xs);
  }

  .process__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .process__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    opacity: 0.4;
    padding-top: calc(36px / 2 + var(--space-md));
  }

  @media (max-width: 768px) {
    .process {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .process__arrow {
      padding-top: 0;
      transform: rotate(90deg);
      justify-content: flex-start;
      padding-left: calc(36px / 2 - 10px);
    }

    .process__step {
      text-align: left;
      display: grid;
      grid-template-columns: 36px 1fr;
      grid-template-rows: auto auto;
      column-gap: var(--space-md);
      align-items: start;
    }

    .process__number {
      margin-bottom: 0;
      grid-row: 1 / 3;
    }

    .process__title {
      align-self: center;
    }

    .process__desc {
      grid-column: 2;
    }
  }
</style>
