---
---

<div class="social-proof">
  <div class="container social-proof__container">
    <span class="social-proof__label">Zaufali mi:</span>
    <div class="social-proof__logos">
      <span class="social-proof__brand">
        <strong>KaeMSTAL</strong>
        <small>Producent garaży</small>
      </span>
      <span class="social-proof__separator" aria-hidden="true"></span>
      <span class="social-proof__brand">
        <strong>Holz-Stal</strong>
        <small>Garaże drewnopodobne</small>
      </span>
      <span class="social-proof__separator" aria-hidden="true"></span>
    </div>
  </div>
</div>

<style>
  .social-proof {
    padding: var(--space-xl) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .social-proof__container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    flex-wrap: wrap;
  }

  .social-proof__label {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    font-weight: 500;
  }

  .social-proof__logos {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .social-proof__brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .social-proof__brand strong {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .social-proof__brand small {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  .social-proof__brand--muted {
    font-size: var(--text-sm);
    color: var(--color-text-dim);
    font-style: italic;
  }

  .social-proof__separator {
    width: 1px;
    height: 28px;
    background: var(--color-border);
  }

  @media (max-width: 768px) {
    .social-proof__container {
      flex-direction: column;
      gap: var(--space-md);
      text-align: center;
    }
  }

  @media (max-width: 480px) {
    .social-proof__logos {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-md);
    }

    .social-proof__separator {
      display: none;
    }
  }
</style>
